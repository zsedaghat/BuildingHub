<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>BuildingHub | مدیریت ساختمان</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/admin/assets/vendor/fonts/iconify-icons.css" />
    <link rel="stylesheet" href="/admin/assets/vendor/css/core.css" />
    <link rel="stylesheet" href="/admin/assets/css/demo.css" />
    <link rel="stylesheet" href="/admin/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.css" />
    <link rel="stylesheet" href="/css/buildinghub-theme.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bh-body">
<div class="bh-shell">
    <aside class="bh-sidebar" id="bhSidebar">
        <a class="bh-brand" href="/">
            <span class="bh-brand-mark">
                <svg viewBox="0 0 48 48" aria-hidden="true"><path d="M7 22 24 7l17 15v19H29V28H19v13H7z"/><path d="M16 19v-6M32 19v-6"/></svg>
            </span>
            <span class="bh-brand-name">Building<span>Hub</span><small>مدیریت هوشمند ساختمان</small></span>
        </a>

        <div class="bh-side-caption">منوی اصلی</div>
        <nav class="bh-nav">
            <a class="bh-nav-link" href="/"><i class="bx bx-grid-alt"></i><span>داشبورد</span></a>
                <a class="bh-nav-link" href="/Communities"><i class="bx bx-group"></i><span>مدیریت جامعه‌ها</span></a>
            <a class="bh-nav-link" href="/Buildings"><i class="bx bx-buildings"></i><span>مدیریت ساختمان‌ها</span></a>
          
        </nav>

        <div class="bh-side-caption">مدیریت مالی</div>
        <nav class="bh-nav">
            <a class="bh-nav-link is-disabled" href="#" title="به‌زودی"><i class="bx bx-receipt"></i><span>شارژ و بدهی‌ها</span><em>به‌زودی</em></a>
            <a class="bh-nav-link is-disabled" href="#" title="به‌زودی"><i class="bx bx-wallet"></i><span>پرداخت‌ها</span><em>به‌زودی</em></a>
            <a class="bh-nav-link is-disabled" href="#" title="به‌زودی"><i class="bx bx-money-withdraw"></i><span>هزینه‌ها</span><em>به‌زودی</em></a>
        </nav>

        <div class="bh-side-caption">سیستم</div>
        <nav class="bh-nav">
            <a class="bh-nav-link is-disabled" href="#"><i class="bx bx-chart"></i><span>گزارش‌ها</span><em>به‌زودی</em></a>
            <a class="bh-nav-link is-disabled" href="#"><i class="bx bx-cog"></i><span>تنظیمات</span><em>به‌زودی</em></a>
        </nav>

        <div class="bh-sidebar-bottom">
            <div class="bh-help-card">
                <span class="bh-help-icon"><i class="bx bx-support"></i></span>
                <strong>به کمک نیاز دارید؟</strong>
                <small>راهنمای استفاده از BuildingHub</small>
            </div>
            <div class="bh-version">BuildingHub <span>نسخه ۱.۰</span></div>
        </div>
    </aside>

    <main class="bh-main">
        <header class="bh-topbar">
            <button class="bh-menu-toggle" type="button" id="bhMenuToggle" aria-label="باز کردن منو"><i class="bx bx-menu"></i></button>
            <div class="bh-breadcrumb"><span>BuildingHub</span><i class="bx bx-chevron-left"></i><strong>پنل مدیریت</strong></div>
            <div class="bh-top-actions">
                <button class="bh-icon-button" type="button" aria-label="اعلان‌ها"><i class="bx bx-bell"></i><b></b></button>
                <div class="bh-user">
                    <span class="bh-avatar"><i class="bx bx-user"></i></span>
                    <span class="bh-user-copy"><strong>مدیر سیستم</strong><small>خوش آمدید</small></span>
                    <i class="bx bx-chevron-down bh-user-chevron"></i>
                </div>
            </div>
        </header>

        <section class="bh-content">
            @RenderBody()
        </section>

        <footer class="bh-footer">
            <span>© @DateTime.Now.Year BuildingHub</span>
            <span>ساخته‌شده برای مدیریت ساده‌تر ساختمان‌ها <i class="bx bxs-heart"></i></span>
        </footer>
    </main>
</div>
<div class="bh-mobile-overlay" id="bhMobileOverlay"></div>
<script src="/admin/assets/vendor/libs/jquery/jquery.js"></script>
<script src="/admin/assets/vendor/libs/popper/popper.js"></script>
<script src="/admin/assets/vendor/js/bootstrap.js"></script>
<script src="/admin/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.js"></script>
<script src="/admin/assets/vendor/js/menu.js"></script>
<script src="/admin/assets/js/main.js"></script>
<script>
(() => {
    const sidebar = document.getElementById('bhSidebar');
    const overlay = document.getElementById('bhMobileOverlay');
    const toggle = document.getElementById('bhMenuToggle');
    const close = () => { sidebar.classList.remove('is-open'); overlay.classList.remove('is-visible'); };
    toggle?.addEventListener('click', () => { sidebar.classList.toggle('is-open'); overlay.classList.toggle('is-visible'); });
    overlay?.addEventListener('click', close);
    const path = location.pathname.toLowerCase();
    document.querySelectorAll('.bh-nav-link').forEach(link => {
        const href = (link.getAttribute('href') || '').toLowerCase();
        if (href !== '/' && href !== '#' && path.startsWith(href)) link.classList.add('active');
        else if (href === '/' && path === '/') link.classList.add('active');
    });
})();
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
