@model BuildingHub.Web.Models.Communities.CommunityListItemViewModel
@{ ViewData["Title"] = "حذف جامعه"; }
<partial name="_CommunityStyles" />
<div class="container-xxl flex-grow-1 container-p-y bh-page">
    <div class="bh-page-heading mb-4"><span class="bh-heading-icon" style="background:#fff0f0;color:#ff3e1d"><i class="bx bx-trash"></i></span><div><h4 class="bh-title mb-1">حذف جامعه</h4><p class="bh-subtitle mb-0">پیش از حذف، وابستگی‌های این جامعه را بررسی کنید.</p></div></div>
    <div class="card bh-card bh-form-card"><div class="card-body p-4">
        <div class="alert alert-warning"><i class="bx bx-error-circle me-1"></i> اگر ساختمانی به این جامعه متصل باشد، حذف ممکن است به دلیل محدودیت ارتباطی پایگاه داده انجام نشود.</div>
        <p>آیا از حذف جامعه <strong>@Model.Name</strong> مطمئن هستید؟</p>
        @if (!string.IsNullOrWhiteSpace(Model.Description)) { <p class="text-muted">@Model.Description</p> }
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post"><button type="submit" class="btn btn-danger"><i class="bx bx-trash me-1"></i> حذف جامعه</button> <a asp-action="Index" class="btn btn-outline-secondary">انصراف</a></form>
    </div></div>
</div>
