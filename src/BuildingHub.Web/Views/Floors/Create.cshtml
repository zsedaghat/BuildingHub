@model BuildingHub.Web.Models.Floors.FloorFormViewModel
@{ ViewData["Title"] = "افزودن طبقه"; }
<partial name="_BuildingStyles" />
<div class="container-xxl flex-grow-1 container-p-y bh-page">
    <div class="bh-page-heading mb-4"><span class="bh-heading-icon"><i class="bx bx-layer"></i></span><div><h4 class="bh-title mb-1">افزودن طبقه جدید</h4><p class="bh-subtitle mb-0">ساختمان و مشخصات طبقه را وارد کنید.</p></div></div>
    <div class="card bh-card bh-form-card"><div class="card-header d-flex align-items-center gap-2"><i class="bx bx-edit fs-4" style="color:#696cff"></i><h5 class="bh-card-title mb-0">اطلاعات طبقه</h5></div><div class="card-body p-4">
        <form asp-action="Create" method="post">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="mb-3"><label asp-for="BuildingId" class="form-label">ساختمان <span class="text-danger">*</span></label><select asp-for="BuildingId" asp-items="Model.Buildings" class="form-select"><option value="">انتخاب ساختمان</option></select><span asp-validation-for="BuildingId" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="Name" class="form-label">نام طبقه <span class="text-danger">*</span></label><input asp-for="Name" class="form-control" placeholder="مثلاً طبقه اول" /><span asp-validation-for="Name" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="FloorNumber" class="form-label">شماره طبقه</label><input asp-for="FloorNumber" type="number" class="form-control" /><span asp-validation-for="FloorNumber" class="text-danger"></span><div class="form-text">برای زیرزمین می‌توانید عدد منفی وارد کنید؛ همکف معمولاً صفر است.</div></div>
            <div class="mb-4"><label asp-for="DisplayOrder" class="form-label">ترتیب نمایش</label><input asp-for="DisplayOrder" type="number" min="0" class="form-control" /><span asp-validation-for="DisplayOrder" class="text-danger"></span><div class="form-text">عدد کوچک‌تر در فهرست زودتر نمایش داده می‌شود.</div></div>
            <hr class="my-4" /><div class="d-flex flex-wrap gap-2"><button type="submit" class="btn btn-primary"><i class="bx bx-save me-1"></i> ثبت طبقه</button><a asp-action="Index" class="btn btn-outline-secondary"><i class="bx bx-arrow-back me-1"></i> بازگشت به فهرست</a></div>
        </form></div></div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
