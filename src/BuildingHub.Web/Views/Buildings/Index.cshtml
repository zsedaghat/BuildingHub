@model BuildingHub.Web.Models.Pagination.PagedListViewModel<BuildingHub.Web.Models.Buildings.BuildingListItemViewModel>

@{
    ViewData["Title"] = "مدیریت ساختمان‌ها";
}

<partial name="_BuildingStyles" />

<div class="container-xxl flex-grow-1 container-p-y bh-page">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div class="bh-page-heading">
            <span class="bh-heading-icon"><i class="bx bx-buildings"></i></span>
            <div>
                <h4 class="bh-title mb-1">مدیریت ساختمان‌ها</h4>
                <p class="bh-subtitle mb-0">ساختمان‌های مجموعه را از این بخش مدیریت کنید.</p>
            </div>
        </div>
        <a asp-controller="Buildings" asp-action="Create" class="btn btn-primary">
            <i class="bx bx-plus me-1"></i> افزودن ساختمان جدید
        </a>
    </div>

    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="alert alert-success alert-dismissible" role="alert">
            <i class="bx bx-check-circle me-1"></i> @success
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="alert alert-danger alert-dismissible" role="alert">
            @error
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (ViewBag.Error is string pageError)
    {
        <div class="alert alert-danger" role="alert">@(pageError)</div>
    }

    <div class="card bh-card">
        <div class="bh-card-header">
            <div class="d-flex align-items-center gap-2">
                <i class="bx bx-list-ul fs-4" style="color:#696cff"></i>
                <h5 class="bh-card-title">فهرست ساختمان‌ها</h5>
            </div>
            <span class="badge bg-label-primary rounded-pill px-3 py-2">
                <i class="bx bx-buildings me-1"></i> @Model.TotalCount ساختمان
            </span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover bh-table mb-0">
                <thead>
                    <tr>
                        <th>نام ساختمان</th>
                        <th>توضیحات</th>
                        <th>جامعه</th>
                        <th class="text-center">ترتیب نمایش</th>
                        <th class="text-center">عملیات</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Items.Count > 0)
                {
                    foreach (var building in Model.Items)
                    {
                        <tr>
                            <td><span class="bh-building-name"><i class="bx bx-building-house me-1" style="color:#696cff"></i>@building.Name</span></td>
                            <td>@(string.IsNullOrWhiteSpace(building.Description) ? "—" : building.Description)</td>
                            <td><span class="bh-community" title="@building.CommunityName">@building.CommunityName</span></td>
                            <td class="text-center"><span class="bh-order">@building.DisplayOrder</span></td>
                            <td class="text-center">
                                <div class="d-inline-flex gap-2">
                                    <a asp-action="Edit" asp-route-id="@building.Id" class="btn btn-sm btn-icon btn-outline-primary" title="ویرایش" aria-label="ویرایش">
                                        <i class="bx bx-edit-alt"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@building.Id" class="btn btn-sm btn-icon btn-outline-danger" title="حذف" aria-label="حذف">
                                        <i class="bx bx-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center bh-empty">
                            <i class="bx bx-buildings fs-1 d-block mb-2"></i>
                            <strong class="d-block mb-1">هنوز ساختمانی ثبت نشده است</strong>
                            <span>برای شروع، اولین ساختمان مجموعه را اضافه کنید.</span>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        @await Html.PartialAsync("_Pagination", Model)
    </div>
</div>
