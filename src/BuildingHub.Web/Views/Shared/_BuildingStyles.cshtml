<style>
    .bh-page { --bh-primary: #304C89; --bh-primary-soft: #EEF2FA; }
    .bh-page .bh-page-heading { display:flex; align-items:center; gap:14px; }
    .bh-page .bh-heading-icon { width:52px; height:52px; display:inline-flex; align-items:center; justify-content:center; border-radius:14px; background:var(--bh-primary-soft); color:var(--bh-primary); font-size:1.7rem; }
    .bh-page .bh-title { color:#26384A; font-weight:700; letter-spacing:-.3px; }
    .bh-page .bh-subtitle { color:#8592a3; }
    .bh-page .bh-card { border:0; border-radius:14px; box-shadow:0 2px 10px rgba(67,89,113,.08); overflow:hidden; }
    .bh-page .bh-card-header { display:flex; align-items:center; justify-content:space-between; gap:12px; padding:1.15rem 1.5rem; background:linear-gradient(90deg,#F1F4FA 0%,#FAFBFD 100%); border-bottom:1px solid #DCE4F1; }
    .bh-page .bh-card-title { color:#304C89; font-weight:700; margin:0; }
    .bh-page .bh-table thead th { background:#F1F4FA; color:#49638F; font-size:.78rem; font-weight:700; border-bottom:1px solid #DCE4F1; padding:1rem 1.1rem; }
    .bh-page .bh-table tbody td { padding:1rem 1.1rem; vertical-align:middle; color:#566a7f; }
    .bh-page .bh-table tbody tr:hover { background:#FAFBFD; }
    .bh-page .bh-building-name { color:#26384A; font-weight:700; }
    .bh-page .bh-order { display:inline-flex; min-width:30px; height:30px; align-items:center; justify-content:center; border-radius:9px; background:#EEF2FA; color:#304C89; font-weight:700; }
    .bh-page .bh-form-card { max-width:850px; }
    .bh-page .bh-form-card .card-header { background:linear-gradient(90deg,#F1F4FA,#fff); border-bottom:1px solid #DCE4F1; padding:1.15rem 1.5rem; }
    .bh-page .bh-form-card .form-label { color:#566a7f; font-weight:600; }
    .bh-page .bh-form-card .form-control:focus, .bh-page .bh-form-card .form-select:focus { border-color:#AAB9D5; box-shadow:0 0 0 .18rem rgba(48,76,137,.14); }
    .bh-page .bh-empty { padding:3rem 1rem!important; color:#8592a3!important; }
    .bh-page .bh-empty i { color:#F4A261; }
    .bh-page .btn-primary { box-shadow:0 3px 8px rgba(48,76,137,.22); }
    .bh-page .bh-community { display:inline-block; max-width:220px; overflow:hidden; text-overflow:ellipsis; vertical-align:middle; }
    @@media(max-width:767px) { .bh-page .bh-card-header { align-items:flex-start; flex-direction:column; } .bh-page .bh-page-heading { align-items:flex-start; } }

    /* BuildingHub: keep primary actions readable without hover */
    .bh-page .bh-page-heading > .btn-primary,
    .bh-page .btn-primary,
    .bh-page button.btn-primary,
    .bh-page a.btn-primary {
        background-color: #304C89 !important;
        border-color: #304C89 !important;
        color: #FFFFFF !important;
        opacity: 1 !important;
        text-decoration: none !important;
        font-weight: 700;
    }
    .bh-page .bh-page-heading > .btn-primary:hover,
    .bh-page .btn-primary:hover,
    .bh-page button.btn-primary:hover,
    .bh-page a.btn-primary:hover,
    .bh-page .btn-primary:focus,
    .bh-page .btn-primary:active {
        background-color: #203966 !important;
        border-color: #203966 !important;
        color: #FFFFFF !important;
    }
    /* RTL select: place the dropdown arrow on the left, away from its text */
    .bh-page select.form-select {
        direction: rtl;
        text-align: right;
        padding-right: .875rem !important;
        padding-left: 2.5rem !important;
        background-position: left .85rem center !important;
        background-origin: content-box;
    }

</style>
