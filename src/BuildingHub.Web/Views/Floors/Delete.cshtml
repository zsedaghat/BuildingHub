@model BuildingHub.Web.Models.Floors.FloorListItemViewModel
@{ ViewData["Title"] = "حذف طبقه"; }
<partial name="_BuildingStyles" />
<div class="container-xxl flex-grow-1 container-p-y bh-page">
    <div class="bh-page-heading mb-4"><span class="bh-heading-icon" style="background:#fff0f0;color:#dc3545"><i class="bx bx-trash"></i></span><div><h4 class="bh-title mb-1">حذف طبقه</h4><p class="bh-subtitle mb-0">پیش از حذف، اطلاعات طبقه را بررسی کنید.</p></div></div>
    <div class="card bh-card bh-form-card"><div class="card-body p-4">
        <div class="alert alert-warning"><i class="bx bx-error-circle me-1"></i> آیا از حذف این طبقه مطمئن هستید؟ این عملیات قابل بازگشت نیست.</div>
        <dl class="row mb-4"><dt class="col-sm-4">نام طبقه</dt><dd class="col-sm-8">@Model.Name</dd><dt class="col-sm-4">ساختمان</dt><dd class="col-sm-8">@Model.BuildingName</dd><dt class="col-sm-4">شماره طبقه</dt><dd class="col-sm-8">@Model.FloorNumber</dd><dt class="col-sm-4">ترتیب نمایش</dt><dd class="col-sm-8">@Model.DisplayOrder</dd></dl>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post">@Html.AntiForgeryToken()<button type="submit" class="btn btn-danger"><i class="bx bx-trash me-1"></i> حذف طبقه</button><a asp-action="Index" class="btn btn-outline-secondary ms-2">انصراف</a></form>
    </div></div>
</div>
